
# NexosFiscal Microservice
FISCAL_MASTER_API_KEY=master-secret-local-123
FISCAL_MICROSERVICE_URL=http://fiscal-api:5000/api/v1
# OBRIGATÓRIO em produção: assina/valida o HMAC do webhook do NexosFiscal
# (POST /fiscal/webhook). Sem essa variável, o código cai num segredo padrão
# fixo (visível no código-fonte) — qualquer um poderia forjar um webhook de
# aprovação/rejeição de NF-e. Gere um valor aleatório longo e único.
FISCAL_WEBHOOK_SECRET=troque-por-um-segredo-aleatorio-forte

# TRAVA DE SEGURANÇA FISCAL: deixe ausente/false. Com qualquer outro valor que não "true",
# o sistema NUNCA emite em produção (notas com valor fiscal): só homologação.
# Só defina FISCAL_ALLOW_PRODUCTION=true no servidor real, depois de homologar tudo e com o contador.
# FISCAL_ALLOW_PRODUCTION=false

# Reconciliação periódica do status das notas com o serviço fiscal (rede de segurança dos webhooks)
# FISCAL_RECONCILE_ENABLED=true
# FISCAL_RECONCILE_INTERVAL_MS=300000
# Em produção FISCAL_WEBHOOK_SECRET é obrigatório e não pode ser o valor de exemplo.
